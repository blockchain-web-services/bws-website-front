---
// Permanent redirect: the Badges.ninja product page moved to /marketplace/badges.
const target = "/marketplace/badges.html";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Badges.ninja - BWS</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`https://www.bws.ninja${target}`} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>This page has moved. <a href={target}>Continue to Badges.ninja →</a></p>
  </body>
</html>
